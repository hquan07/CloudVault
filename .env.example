# ============================================
# CloudVault — Environment Configuration
# ============================================

# Generate each secret independently with: openssl rand -hex 32

# ── MySQL ──
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cloudvault
MYSQL_USER=cloudvault
MYSQL_PASSWORD=

# ── Redis ──
REDIS_PASSWORD=

# ── MinIO (S3-compatible Object Storage) ──
MINIO_ROOT_USER=cloudvault_admin
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
# Hostname:port reachable by end-user browsers for presigned download URLs.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_FILES=cloudvault-files
MINIO_BUCKET_THUMBNAILS=cloudvault-thumbnails
MINIO_BUCKET_AVATARS=cloudvault-avatars

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_FILE_EVENTS=file-events
KAFKA_TOPIC_USER_EVENTS=user-events

# ── Elasticsearch ──
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
ELASTICSEARCH_USERNAME=cloudvault_app
ELASTICSEARCH_APP_PASSWORD=

# ── Grafana ──
GRAFANA_ADMIN_PASSWORD=

# ── JWT ──
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Nginx ──
NGINX_PORT=80
NGINX_BIND_ADDRESS=0.0.0.0

# Internal/admin ports bind to loopback by default. Change only when protected
# by a firewall or private network.
APP_BIND_ADDRESS=127.0.0.1
INFRA_BIND_ADDRESS=127.0.0.1

# ── Service URLs (for inter-service communication) ──
AUTH_SERVICE_URL=http://auth-service:8000
FILE_SERVICE_URL=http://file-service:8000
METADATA_SERVICE_URL=http://metadata-service:8000

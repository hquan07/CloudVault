# ============================================
# CloudVault — Environment Configuration
# ============================================

# Generate each secret independently with: openssl rand -hex 32

# ── MySQL ──
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=cloudvault
MYSQL_USER=cloudvault
MYSQL_PASSWORD=

# ── Redis ──
REDIS_PASSWORD=

# ── MinIO (S3-compatible Object Storage) ──
MINIO_ROOT_USER=cloudvault_admin
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=minio:9000
# Hostname:port reachable by end-user browsers for presigned download URLs.
MINIO_PUBLIC_ENDPOINT=localhost:9000
# Comma-separated browser origins allowed to PUT presigned multipart parts.
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost,http://localhost:3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_FILES=cloudvault-files
MINIO_BUCKET_THUMBNAILS=cloudvault-thumbnails
MINIO_BUCKET_AVATARS=cloudvault-avatars

# ── Kafka ──
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_FILE_EVENTS=file-events
KAFKA_TOPIC_USER_EVENTS=user-events
KAFKA_TOPIC_DEAD_LETTER=dead-letter-events
# Development defaults. The HA overlay raises these values to 3 and 2.
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_CONSUMER_RETRY_BACKOFF_SECONDS=2

# ── Application scaling ──
# Pool values apply per API replica. Keep the aggregate below MySQL max_connections.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
# Used by docker-compose.ha.yml. Singleton jobs are intentionally not scaled.
FRONTEND_REPLICAS=2
AUTH_SERVICE_REPLICAS=2
FILE_SERVICE_REPLICAS=2
METADATA_SERVICE_REPLICAS=2
THUMBNAIL_WORKER_REPLICAS=2
SEARCH_INDEXER_REPLICAS=2
AUDIT_LOGGER_REPLICAS=2
ZIP_EXTRACTOR_REPLICAS=2

# ── Elasticsearch ──
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=
ELASTICSEARCH_USERNAME=cloudvault_app
ELASTICSEARCH_APP_PASSWORD=

# ── Grafana ──
GRAFANA_ADMIN_PASSWORD=

# ── Bootstrap administrator ──
# Leave empty in production when administrators are provisioned externally.
BOOTSTRAP_ADMIN_EMAIL=admin@cloudvault.dev

# ── JWT ──
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Nginx ──
NGINX_PORT=80
NGINX_BIND_ADDRESS=0.0.0.0

# Internal/admin ports bind to loopback by default. Change only when protected
# by a firewall or private network.
APP_BIND_ADDRESS=127.0.0.1
INFRA_BIND_ADDRESS=127.0.0.1

# ── Service URLs (for inter-service communication) ──
AUTH_SERVICE_URL=http://auth-service:8000
FILE_SERVICE_URL=http://file-service:8000
METADATA_SERVICE_URL=http://metadata-service:8000

# ── Project operations / Phase 8 ──
# Worker luôn thu metrics. Các cờ thay đổi dữ liệu mặc định tắt để operator
# xem reconciliation trước khi áp dụng.
PROJECT_OPERATIONS_INTERVAL_SECONDS=300
PROJECT_STALE_UPLOAD_MINUTES=30
PROJECT_TRASH_GRACE_DAYS=7
PROJECT_ORPHAN_GRACE_HOURS=24
PROJECT_OPERATIONS_METRICS_PORT=9100
PROJECT_APPLY_STALE_UPLOAD_CLEANUP=false
PROJECT_APPLY_RETENTION=false
PROJECT_APPLY_USAGE_RECONCILIATION=false
PROJECT_DELETE_ORPHANS=false
